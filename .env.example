SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
NFL_DFS_TOOLS_PATH=../NFL-DFS-Tools
# Server-only. Never NEXT_PUBLIC_. Set on Vercel as a server env var.
# Models are per-phase in code: explain=gemini-3.5-flash-lite, claims/optimize-nl=gemini-3.8-flash.
GEMINI_API_KEY=
# Server-side CLI only (nfl-edge ingest odds-api). Never web/.env.local, never NEXT_PUBLIC_.
ODDS_API_KEY=
# Server-side CLI only (nfl-edge benchmark fantasypros / ingest fantasypros-status). Never web/.env.local, never NEXT_PUBLIC_.
FANTASY_PROS_API_KEY=
# Browser cookies on fantasy.espn.com (nfl-edge ingest espn-league). Server-side CLI only, never web/.env.local.
ESPN_S2=
# SWID cookie keeps its curly braces.
ESPN_SWID=
